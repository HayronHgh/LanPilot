# Stage the actual built product. No program is installed, launched or granted
# access; the only writes are in a fresh directory under the build tree.
if(NOT IS_ABSOLUTE "${BUILD_ROOT}" OR NOT EXISTS "${BUILD_ROOT}/CMakeCache.txt")
  message(FATAL_ERROR "An existing absolute CMake build tree is required")
endif()
if(HOST_SYSTEM STREQUAL "Windows")
  set(installer_target LanPilot-Setup)
  set(installer LanPilot-Setup.exe)
  set(compat_program bin/rwn-viewer.exe)
  set(compat_script bin/Install-DesktopPreview.ps1)
elseif(HOST_SYSTEM STREQUAL "Darwin")
  set(installer_target lanpilot-macos-installer)
  set(installer LanPilot-macOS-UNSIGNED.pkg)
  set(compat_program bin/rwn-desktop-agent)
  set(compat_script bin/install-desktop-preview.sh)
else()
  message(FATAL_ERROR "Unsupported desktop package platform")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_ROOT}"
  --config "${CONFIG}" --target "${installer_target}" --parallel 4
  RESULT_VARIABLE result TIMEOUT 180)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Desktop installer build failed: ${result}")
endif()

file(REAL_PATH "${BUILD_ROOT}" build_path)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${build_path}/desktop-package-workflow-${suffix}")
if(EXISTS "${root}")
  message(FATAL_ERROR "Refusing to reuse a package test directory")
endif()
foreach(component IN ITEMS desktop desktop-compat)
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_ROOT}"
    --config "${CONFIG}" --component "${component}" --prefix "${root}/${component}"
    RESULT_VARIABLE result TIMEOUT 60)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${component} staging failed: ${result}; evidence: ${root}")
  endif()
endforeach()

file(GLOB_RECURSE actual LIST_DIRECTORIES false RELATIVE "${root}/desktop"
  "${root}/desktop/*")
set(expected "${installer}" LICENSE README.md)
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Product package must contain only installer, README and license. Found: ${actual}; evidence: ${root}")
endif()
file(SIZE "${root}/desktop/${installer}" bytes)
if(bytes LESS 1024)
  message(FATAL_ERROR "Missing or empty desktop installer")
endif()
file(SHA256 "${root}/desktop/${installer}" hash)
foreach(required IN ITEMS "${compat_program}" "${compat_script}" README.md LICENSE)
  if(NOT EXISTS "${root}/desktop-compat/${required}")
    message(FATAL_ERROR "Explicit compatibility bundle lost ${required}; evidence: ${root}")
  endif()
endforeach()
if(EXISTS "${root}/desktop-compat/${installer}")
  message(FATAL_ERROR "Compatibility tools must not duplicate the product installer")
endif()
message(STATUS "Desktop package PASS: ${installer} bytes=${bytes} sha256=${hash}; compatibility preserved")
# root is a freshly generated, absolute child of the verified build directory.
file(REMOVE_RECURSE "${root}")
